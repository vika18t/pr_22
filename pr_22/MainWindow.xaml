<Window x:Class="pr_22.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr_22"
        mc:Ignorable="d"
        Title="Библиотека" Height="750" Width="800">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ScrollViewer Grid.Row="0">
			<ItemsControl x:Name="BookPanel">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<WrapPanel/>
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border BorderBrush="Gray" BorderThickness="1"
                                Margin="6" Padding="6" Width="140"
                                MouseLeftButtonDown="Book_Click">
							<StackPanel>
								<Image Source="{Binding Cover}" Height="150"/>
								<TextBlock Text="{Binding Title}" FontWeight="Bold"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Margin="0,4,0,0"/>
							</StackPanel>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<Border Grid.Row="1"
                BorderBrush="Gray" BorderThickness="1"
                Background="#F0F0F0"
                Margin="0,10,0,0" Padding="12">
			<StackPanel>
				<TextBlock Text="Подробная информация о книге"
                           FontSize="14" FontWeight="Bold"
                           Margin="0,0,0,10"/>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="160"/>
						<ColumnDefinition Width="80"/>
						<ColumnDefinition Width="20"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="80"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="36"/>
						<RowDefinition Height="36"/>
						<RowDefinition Height="36"/>
						<RowDefinition Height="36"/>
						<RowDefinition Height="36"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Grid.Column="0" Text="Название:"
                               VerticalAlignment="Center"/>
					<TextBox   Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                               x:Name="TitleBox"
                               Margin="0,6,0,6" Padding="4,2,4,2"
                               VerticalContentAlignment="Center"/>

					<TextBlock Grid.Row="1" Grid.Column="0" Text="Автор:"
                               VerticalAlignment="Center"/>
					<TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                               x:Name="AuthorBox"
                               Margin="0,6,0,6" Padding="4,2,4,2"
                               VerticalContentAlignment="Center"/>

					<TextBlock Grid.Row="2" Grid.Column="0" Text="Обложка (путь):"
                               VerticalAlignment="Center"/>
					<TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
                               x:Name="CoverBox"
                               Margin="0,6,0,6" Padding="4,2,4,2"
                               VerticalContentAlignment="Center"/>

					<TextBlock Grid.Row="3" Grid.Column="0" Text="Количество в наличии:"
                               VerticalAlignment="Center"/>
					<TextBox   Grid.Row="3" Grid.Column="1"
                               x:Name="CountBox"
                               Margin="0,6,0,6" Padding="4,2,4,2"
                               VerticalContentAlignment="Center"/>
					<TextBlock Grid.Row="3" Grid.Column="3" Text="На руках:"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
					<TextBox   Grid.Row="3" Grid.Column="4"
                               x:Name="TakenBox"
                               Margin="0,6,0,6" Padding="4,2,4,2"
                               VerticalContentAlignment="Center"/>

					<TextBlock Grid.Row="4" Grid.Column="0" 
                               VerticalAlignment="Center"/>
					<TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                               x:Name="StatusText"
                               VerticalAlignment="Top" FontWeight="Bold"
                               Margin="0,6,0,6"/>
				</Grid>
				<StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,15,0,5">
					<Button Content="Добавить книгу" Width="120" Margin="5" Click="Add_Click"/>
					<Button Content="Удалить книгу"  Width="120" Margin="5" Click="Del_Click"/>
					<Button Content="Выдать книгу"   Width="120" Margin="5" Click="Give_Click"/>
					<Button Content="Вернуть книгу"  Width="120" Margin="5" Click="Return_Click"/>
				</StackPanel>
			</StackPanel>
		</Border>
	</Grid>
</Window>